# =============================================================================
# epay-fortify-gradle — HP Fortify SCA 24.4 + Gradle 9.4.1 (build-integration SAST)
# =============================================================================
# Adds ONLY Gradle to the DSO Fortify image. Fortify's session-write location is
# handled at RUN TIME by the sast job (FORTIFY_HOME → $CI_PROJECT_DIR), NOT by a
# USER line here — the base image runs as root and there is no 'default' user, so
# any USER override risks an unwritable $HOME/.fortify (the earlier failure).
#
# ── Air-gap build ─────────────────────────────────────────────────────────────
#   On bastion:  unzip gradle-9.4.1-bin.zip   → gradle-9.4.1/
#   podman build --build-arg GRADLE_VERSION=9.4.1 \
#     -t artifactory.jfrog.sbi:443/dso-docker-base-images/epay-fortify-gradle:1.2 .
#   podman tag  ...:1.2  ...itepaypg-sbiepay2-docker-local/sast/epay-fortify-gradle:1.2
#   podman push ...itepaypg-sbiepay2-docker-local/sast/epay-fortify-gradle:1.2 --tls-verify=false
# =============================================================================

FROM artifactory.jfrog.sbi:443/dso-base-image/ubi9/ubi9-java21-fortify-24.4:2.0

LABEL maintainer="itepaypg-sbiepay2-devops@sbi.co.in" \
      image.name="epay-fortify-gradle" \
      image.version="1.2" \
      image.fortify.version="24.4" \
      image.gradle.version="9.4.1" \
      image.description="Fortify SCA 24.4 + Gradle 9.4.1 for build-integration SAST" \
      image.base="dso-base-image/ubi9/ubi9-java21-fortify-24.4:2.0"

ARG GRADLE_VERSION=9.4.1

ENV GRADLE_HOME=/opt/gradle \
    PATH=/opt/gradle/bin:$PATH

# Gradle pre-extracted on bastion: unzip gradle-9.x.x-bin.zip → gradle-9.x.x/
COPY gradle-${GRADLE_VERSION}/ /opt/gradle/

# Build as root (base image default) — validate both tools. NO trailing USER
# override: the base image already runs as root, and the sast job redirects
# Fortify's writable home to $CI_PROJECT_DIR at runtime.
RUN set -eux && \
    chmod +x /opt/gradle/bin/gradle && \
    gradle --version && \
    sourceanalyzer -version

WORKDIR /workspace
# No USER line, no CMD — GitLab CI Docker executor overrides with the job script
