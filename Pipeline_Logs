validate_entry_checklist:
  stage: UAT-entry-checklist
  image: artifactory.jfrog.sbi:443/dso-docker-base-images/ubi9/ubi9-podman-git-python-helm-jinja:1.0
  allow_failure: false

  inputs:
    epm_demand_project_id_mapped: 
      default: "No"
      description: " EPM “Demand id – Project id” is SSOT in Bank. UAT  sign-offs will be provided at Project id levels. Each Project id is unique in ecosystem and should be mapped to a unique CI/CD Epic id or a unique child epic id"
      options: ["Yes", "No"]

    test_scope_finalized:
      default: "No"
      description: "  The Test Scope should be finalized"
      options: ["Yes", "No"]

    sit_completed_with_report:
      default: "No"
      description: " SIT should be successfully completed before commencing UAT. SIT completion report in standard QACoE format should be provided for certifying the conclusion of SIT (zero open defects, 100% test case passed and null values and others error have been appropriately handled"
      options: ["Yes", "No"]

    sit_execution_evidence_attached:
      default: ""
      description: " Execution evidences for successful SIT completion should be attached."

    dedicated_test_env_available:
      default: "No"
      description: " A dedicated test environment with relevant build should be available for UAT testing"
      options: ["Yes", "No"]

    build_hash_shared:
      default: "No"
      description: " Hash of the build deployed to be shared with UAT"
      options: ["Yes", "No"]

    functionality_walkthrough_done:
      default: "No"
      description: "  The AO/Development team will organize a document based walkthrough of the functionality for the UAT team"
      options: ["Yes", "No"]

    test_data_available:
      default: "No"
      description: "  Requisite test data for testing should be made available by IT AO / BU"
      options: ["Yes", "No"]

    far_access_provided:
      default: "No"
      description: " FAR access to the application under test from UAT team IPs for all types of testing required"
      options: ["Yes", "No"]

  before_script:
    - git config --global http.sslVerify false
    - mkdir -p /etc/containers/certs.d/gitlab.sbi
    - cp $GITLAB_CERT /etc/containers/certs.d/gitlab.sbi/ca.crt
    - mkdir -p ~/.gitlab/security/certs
    - cp "$GITLAB_CERT" ~/.gitlab/security/certs/gitlab.crt
    - cp "$GITLAB_CERT" /etc/pki/ca-trust/source/anchors/gitlab.crt
    - update-ca-trust extract

  when: manual
  script:
    - git clone --branch feature_test https://cbs-token:$GITLAB_TOKEN@gitlab.sbi/cb-microservices/cbs_microservices/file-templates.git
    - ls -la ./file-templates/scripts/
    - cd file-templates/scripts/

    - export EPM_DEMAND_PROJECT_ID_MAPPED="${{ job.inputs.epm_demand_project_id_mapped }}"
    - export TEST_SCOPE_FINALIZED="${{ job.inputs.test_scope_finalized }}"
    - export SIT_COMPLETED_WITH_REPORT="${{ job.inputs.sit_completed_with_report }}"
    - export SIT_EXECUTION_EVIDENCE_ATTACHED="${{ job.inputs.sit_execution_evidence_attached }}"
    - export DEDICATED_TEST_ENV_AVAILABLE="${{ job.inputs.dedicated_test_env_available }}"
    - export BUILD_HASH_SHARED="${{ job.inputs.build_hash_shared }}"
    - export FUNCTIONALITY_WALKTHROUGH_DONE="${{ job.inputs.functionality_walkthrough_done }}"
    - export TEST_DATA_AVAILABLE="${{ job.inputs.test_data_available }}"
    - export FAR_ACCESS_PROVIDED="${{ job.inputs.far_access_provided }}" 

    - python3 check_entry_checklist.py









