# ci/image/image.scan.xray.yml  |  Stage: image-scan
# JFrog Xray image scan — deep CVE + licence scan before push

include:
  - local: ci/image/image.podman.setup.yml

.image_scan_xray:
  stage: image-scan
  extends: .setup_jfrog_podman
  allow_failure: true
  script:
    - |
      echo "Scanning TAR: $TAR_NAME"
      jf scan "$TAR_NAME" \
        --watches=EPAY-WATCHER \
        --fail=true

image:scan:xray:
  extends: .image_scan_xray


