    - git config --global http.sslVerify false
    - mkdir -p /etc/containers/certs.d/gitlab.sbi
    - cp $GITLAB_CERT /etc/containers/certs.d/gitlab.sbi/ca.crt
    - mkdir -p ~/.gitlab/security/certs
    - cp "$GITLAB_CERT" ~/.gitlab/security/certs/gitlab.crt
    - cp "$GITLAB_CERT" /etc/pki/ca-trust/source/anchors/gitlab.crt 
    - update-ca-trust extract
  
  script:
    - git clone --branch feature_test https://cbs-token:$GITLAB_TOKEN@gitlab.sbi/cb-microservices/cbs_microservices/file-templates.git
    - ls -la ./file-templates/scripts/
    - cd file-templates/scripts/

    - export ALL_TEST_CASES_EXECUTED="${{ job.inputs.all_test_cases_executed }}"
    - export NO_OUTSTANDING_DEFECTS="${{ job.inputs.no_outstanding_defects }}"
    - export BU_SIGNOFF_RECEIVED="${{ job.inputs.bu_signoff_received }}"
    - export DEVIATION_APPROVALS="${{ job.inputs.deviation_approvals }}" 

    - python3 check_exit_checklist.py  




