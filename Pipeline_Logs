echo "=== Routes in front ==="
oc get route -A | grep -iE "integration|sbiuat"
echo "=== Gateway TLS spec ==="
oc get gateway -n int-istio-system int-gateway -o yaml | grep -A20 -iE "tls:|hosts:|port:"
echo "=== Gateway svc ==="
oc get svc -n int-istio-system | grep -i gateway
echo "=== What the wire serves ==="
echo | openssl s_client -connect integration.sbiepay.sbiuat.bank.in:443 -servername integration.sbiepay.sbiuat.bank.in 2>&1 | openssl x509 -noout -subject -issuer -dates 2>/dev/null
echo "=== Gateway pod errors ==="
oc logs -n int-istio-system -l istio=int-gateway --tail=50 | grep -iE "certificate|verify|TLS_error|no healthy|NR|UF|UH"
