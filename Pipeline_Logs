========================Deployment.yml:



apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "epay_gateway_offline_process_service.fullname" . }}
  labels:
    {{- include "epay_gateway_offline_process_service.labels" . | nindent 4 }}
spec:
  {{- if not .Values.autoscaling.enabled }}
  replicas: {{ .Values.replicaCount }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "epay_gateway_offline_process_service.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      {{- with .Values.podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      labels:
        {{- include "epay_gateway_offline_process_service.labels" . | nindent 8 }}
        {{- with .Values.podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
    spec:
      {{- with .Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      serviceAccountName: {{ include "epay_gateway_offline_process_service.serviceAccountName" . }}
      securityContext:
        {{- toYaml .Values.podSecurityContext | nindent 8 }}
###############################
      {{- if .Values.initContainer.enabled }}
      #Init-container for trust-store
      initContainers:
        - name: import-certs
          image: {{ .Values.initContainer.image }}
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -euo pipefail

              echo "[INFO] Preparing shared cacerts volume..."
              for C in \
                "$JAVA_HOME/lib/security/cacerts" \
                "/usr/lib/jvm/java-21/lib/security/cacerts" \
                "/etc/pki/java/cacerts"; do
                if [ -r "$C" ]; then
                  echo "[INFO] Using truststore at $C"
                  mkdir -p /cacerts/data
                  cp "$C" /cacerts/data/cacerts
                  chmod 660 /cacerts/data/cacerts
                  break
                fi
              done
              echo "[INFO] Importing custom certificates..."
              for f in /etc/custom-certs-gateway-pooling/*.crt /etc/custom-certs-gateway-pooling/*.cer /certs/*.crt /certs/*.cer; do
                [ -e "$f" ] || continue
                base="$(basename "$f")"
                alias="$(echo "$base" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')"
                echo "[INFO] Importing $base as alias $alias"
                keytool -import -trustcacerts -file "$f" \
                  -alias "$alias" \
                  -keystore /cacerts/data/cacerts \
                  -storepass {{ .Values.initContainer.truststorePassword }} -noprompt || true
              done    
          volumeMounts:
            - name: custom-certs-gateway-pooling
              mountPath: /etc/custom-certs-gateway-pooling
            - name: cacerts
              mountPath: /cacerts            
      {{- end }}
#############################################
      containers:
        - name: {{ .Chart.Name }}
          securityContext:
            {{- toYaml .Values.securityContext | nindent 12 }} 
          image: "{{ tpl .Values.image.repository $ }}:{{ .Values.image.tag | default .Chart.AppVersion }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          ports:
            - name: http
              containerPort: {{ .Values.service.port }}
              protocol: TCP
          env:
          - name: JAVA_TOOL_OPTIONS
            value: "-Djavax.net.ssl.trustStore=/cacerts/data/cacerts -Djavax.net.ssl.trustStorePassword=changeit"
          - name: SPRING_CONFIG_LOCATION
            value: file:/opt/gradle/   
          volumeMounts:
            - name: config
              mountPath: "/opt/gradle"
            # - name: gemfire-pooling-cert
            #   readOnly: true
            #   mountPath: /certs
            - name: payment-upivpaqr-cert
              readOnly: true
              mountPath: /certs
            {{- if .Values.customCertsGatewayPooling.enabled }}
            - name: custom-certs-gateway-pooling
              mountPath: {{ .Values.customCertsGatewayPooling.mountPaths }}
              readOnly: true
            {{- end }}
            - name: cacerts
              mountPath: /cacerts
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: pooling-config
        # - name: gemfire-pooling-cert
        #   secret:
        #     secretName: gemfire-dev-cert-pooling
        #     defaultMode: 420
        - name: payment-upivpaqr-cert
          secret:
            secretName: payment-upivpaqr
            defaultMode: 444
        {{- if .Values.customCertsGatewayPooling.enabled }}
        - name: custom-certs-gateway-pooling
          secret:
            secretName: {{ .Values.customCertsGatewayPooling.secretName }} 
        {{- end }}
        - name: cacerts
          emptyDir: {}
  
