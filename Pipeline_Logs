import os, sys

# Mandatory Yes/No confirmations for UAT EXIT (post-UAT, before preprod).
MANDATORY_YES_NO_VARS = {
    "ALL_TEST_CASES_EXECUTED": "All in-scope test cases executed with expected results",
    "NO_OUTSTANDING_DEFECTS": "No outstanding showstopper/critical/major/minor defects",
    "BU_SIGNOFF_RECEIVED": "BU sign-offs received where applicable",
    "DEVIATION_APPROVALS": "Approvals for deviations (out-of-scope / doc change / open defects) in place",
}

failed = [(var, label) for var, label in MANDATORY_YES_NO_VARS.items()
          if os.environ.get(var, "No") != "Yes"]

if failed:
    print("UAT Exit checklist validation FAILED. Not satisfied:")
    for var, label in failed:
        value = os.environ.get(var, "<not set>")
        print(f" - {var}: {label} (current value: '{value}')")
    sys.exit(1)

print("All mandatory UAT exit checklist items confirmed.")











