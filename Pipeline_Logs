# ci/security/sca/sca.xray.yml  |  Stage: security
# JFrog Xray SCA — scans build JAR artifact against Xray watcher policy

.sca_setup:
  before_script:
    - |
      # Trust the SBI internal CA so 'jf' can verify artifactory.jfrog.sbi over TLS.
      # jf is a Go binary and reads the OS trust store (/etc/pki/ca-trust); the
      # podman-jf image does not ship the SBI CA, which caused:
      #   x509: certificate signed by unknown authority
      # Same trust step the checklist/image jobs use, with ARTIFACTORY_CERT.
      cp "$ARTIFACTORY_CERT" /etc/pki/ca-trust/source/anchors/artifactory.crt
      update-ca-trust extract

      jf config add \
        --url="$JF_URL" \
        --xray-url="$JF_XRAY_URL" \
        --user="$JF_USER" \
        --access-token="$JF_TOKEN" \
        --interactive=false \
        epay-server
      jf config use epay-server
      jf rt ping

.sca:
  stage: security
  # Uses the JFrog-CLI image (has the 'jf' binary). The Gradle build image does
  # NOT contain jf, which caused "jf: command not found" (exit 127). This job only
  # runs 'jf scan' on the JAR pulled via dependencies:[build] — no Gradle needed.
  image: artifactory.jfrog.sbi:443/dso-docker-base-images/ubi9/podman-jf:9.7
  tags:
    - common_runner
  extends: .sca_setup
  dependencies:
    - build
  allow_failure: true
  script:
    - ls build/libs/
    - jf scan build/libs/${CI_PROJECT_NAME}-${VERSION}.jar --watches=EPAY-WATCHER --fail=true

sca:xray:
  extends: .sca















