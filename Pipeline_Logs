import os, sys

MANDATORY_YES_NO_VARS = {
    "EPM_DEMAND_PROJECT_ID_MAPPED": "EPM Demand id-Project id mapped to unique CI/CD Epic id",
    "TEST_SCOPE_FINALIZED": "Test Scope finalized",
    "SIT_COMPLETED_WITH_REPORT": "SIT completed with QACoE completion report",
    "DEDICATED_TEST_ENV_AVAILABLE": "Dedicated test environment available for UAT",
    "BUILD_HASH_SHARED": "Build hash shared with UAT",
    "FUNCTIONALITY_WALKTHROUGH_DONE": "Functionality walkthrough conducted for UAT team",
    "TEST_DATA_AVAILABLE": "Requisite test data made available",
    "FAR_ACCESS_PROVIDED": "FAR access provided from UAT team IPs",
}

MANDATORY_ATTACHMENT_VARS = {
    "SIT_EXECUTION_EVIDENCE_ATTACHED": "SIT execution evidence attachment",
}

failed = [(var, label) for var, label in MANDATORY_YES_NO_VARS.items()
          if os.environ.get(var, "No") != "Yes"]

failed += [(var, label) for var, label in MANDATORY_ATTACHMENT_VARS.items()
           if not os.environ.get(var, "").strip()]

if failed:
    print("UAT Entry checklist validation FAILED. Not satisfied:")
    for var, label in failed:
        value = os.environ.get(var, "<not set>")
        print(f" - {var}: {label} (current value: '{value}')")
    sys.exit(1)

print("All mandatory UAT entry checklist items confirmed.")




