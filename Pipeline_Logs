# =============================================================================
# epay-build-java-gradle:1.0.0
# =============================================================================
# Purpose : JDK 21 + Gradle 9.4.1
#           Used by: Java build, test, publish stages
# Base    : ubi9/openjdk-21 (via JFrog proxy)
#
# Pre-download on internet machine, extract on bastion BEFORE docker build:
# Link to download : https://services.gradle.org/distributions/gradle-9.4.1-bin.zip ( binary only)
#   gradle-9.x.x-bin.zip → unzip → gradle-9.x.x/ folder
#   jfrog-chain.crt → will be added in runtime in Gitlab CI to avoid re-generation of dockerfile on jfrog certficate change

FROM artifactory.jfrog.sbi:443/dso-base-image/ubi9/ubi9-java21-fortify-24.4:2.0

LABEL maintainer="devops.sbiepay@sbi.co.in" \
      image.name="epay-build-java-gradle" \
      image.version="1.0.0" \
      image.gradle.version="9.4.1" \
      image.description="Java CI build: OPENJDK 21 + Gradle 9.4.1" \
      image.base="ubi9/ubi9-java21-fortify-24.4:2.0"

ARG GRADLE_VERSION=9.4.1

ENV GRADLE_HOME=/opt/gradle \
    PATH=/opt/gradle/bin:$PATH

# Gradle pre-extracted on bastion: unzip gradle-9.x.x-bin.zip → gradle-9.x.x/
COPY gradle-${GRADLE_VERSION}/ /opt/gradle/

RUN chmod +x /opt/gradle/bin/gradle && gradle --version && sourceanalyzer -version

WORKDIR /workspace

# Non-root user for OpenShift/Kubernetes security
USER 1001
