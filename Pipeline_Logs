FROM .../ubi9-java21-fortify-24.4:2.0     # your working Fortify image
ARG GRADLE_VERSION=9.4.1
ENV PATH=/opt/gradle/bin:$PATH            # so `command -v gradle` succeeds
COPY gradle-${GRADLE_VERSION}/ /opt/gradle/   # your pre-extracted zip
RUN chmod +x /opt/gradle/bin/gradle && gradle --version && sourceanalyzer -version
USER 1001
