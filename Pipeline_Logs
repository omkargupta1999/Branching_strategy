apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Release.Name }}-{{ .Values.configMap.nameSuffix }}
  namespace: {{ .Values.namespace }}
  labels:
    {{- include "Epay_Key_Managment.labels" . | nindent 4 }}
    {{- if $.Values.configMap.additionalLabels }}
    {{- toYaml $.Values.configMap.additionalLabels | nindent 4 }}
    {{- end }}
  {{- if $.Values.configMap.annotations }}
  annotations:
    {{- toYaml $.Values.configMap.annotations | nindent 4 }}
  {{- end }}
data:
  application.yml: |
    server:
      port: 9093
      servlet:
        context-path: /api/kms/v1
    spring:
      application:
        name: KMSApplication
      datasource:
        url: jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=epaydbscandev.sbiepay.sbi)(PORT=1524))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=epaydbdev.sbiepay.sbi)))
        username: ${DB_USERNAME}
        password: ${DB_PASSWORD}
        driver-class-name: oracle.jdbc.OracleDriver
      jpa:
        show-sql: true
      liquibase:
        change-log: classpath:db/changelog/db.changelog-master.xml
        enabled: true
        drop-first: false
    security:
      cors:
        allowed:
          origins: "https://dev.epay.sbi, http://kms-kmsservice.dev-kms.svc.cluster.local:9093"
      whitelist:
        urls: "/api/transaction/v1/actuator/health/**, /actuator/health/**"
    external:
      api:
        admin:
          services:
            base:
              path: http://admin-adminservice.dev-admin.svc.cluster.local:9094/api/admin/v1
    scheduler:
      cron:
        expression:
          api: "0 */5 * * * *"
          encryption: "0 */5 * * * *"
    key:
      aek: BiIZ5feKr16Td3XSpVywqXlwRNfSy9Gtis04WqEbD/0=
    logging:
      level:
        com.epay.sbi: INFO
        com.epay.kms: INFO
        org.springframework: ERROR
