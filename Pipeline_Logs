      echo " Release branch       : $CI_COMMIT_BRANCH"
      echo " Version              : $VERSION"
      echo " Approver (GitLab user): $GITLAB_USER_LOGIN"
      echo "------------------------------------------------------------------"
      echo " UAT deploys (deploy-uat / deploy-int / deploy-perf) are now unlocked."
      echo "=================================================================="
  rules:
    - if: '$CI_COMMIT_BRANCH =~ /^release\//'
      when: manual
      allow_failure: false
    - when: never

