# ci/security/sca/sca.xray.yml  |  Stage: security
# JFrog Xray SCA — scans the build JAR against the Xray watcher policy.
#
# Reuses the SHARED cert-trust + JFrog-CLI setup (.setup_jfrog_podman) from
# ci/image/image.podman.setup.yml — the same setup the image scan uses. This
# removes the duplicated cert/jf-config block that used to live here: one source
# of truth for certificate trust across all jf-based jobs.
#
# SCA vs image scan: this scans ONLY the JAR (your Java dependencies). The image
# scan (ci/image/image.scan.xray.yml) scans the whole container TAR, so it also
# finds OS/base-image CVEs. Keeping SCA separate gives fast, shift-left feedback
# at the 'security' stage — it fails before the (slower) image build + scan.

include:
  - local: ci/image/image.podman.setup.yml

.sca:
  extends: .setup_jfrog_podman     # shared image + cert trust + jf config
  stage: security
  variables:
    JFROG_CLI_AVOID_NEW_VERSION_WARNING: "true"
  dependencies:
    - build           # the JAR to scan
    - version         # version.env dotenv → populates $VERSION for the JAR name.
                      # dependencies: RESTRICTS artifacts to the listed jobs, so
                      # 'version' must be here or $VERSION is empty.
  allow_failure: true
  script:
    - |
      set -eo pipefail
      ls -l build/libs/
      # Prefer the exact VERSION-named JAR; fall back to the single built JAR
      # (excluding Spring's -plain.jar) so a VERSION hiccup can't break the scan.
      JAR="build/libs/${CI_PROJECT_NAME}-${VERSION}.jar"
      if [ ! -f "$JAR" ]; then
        echo "WARN: '$JAR' not found (VERSION='${VERSION}'). Falling back to glob."
        JAR=$(ls build/libs/*.jar 2>/dev/null | grep -v -- '-plain\.jar' | head -1)
      fi
      if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
        echo "ERROR: no scannable JAR found in build/libs/." >&2
        ls -l build/libs/ >&2
        exit 1
      fi
      echo "Scanning: $JAR"
      jf scan "$JAR" --watches=EPAY-WATCHER --fail=true

sca:xray:
  extends: .sca
