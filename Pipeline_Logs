# ci/checklist/validate_exit_checklist.yml
# ──────────────────────────────────────────────────────────────────────────────
# UAT EXIT checklist — manual gate on the RELEASE path.
# Waits for the UAT deploys; running it (after filling the answers) unlocks
# deploy-preprod-dc / deploy-preprod-dr.
#
# Same mechanism as validate_entry_checklist: manual-job VARIABLES form, plain
# $VAR (not component ${{ }}), runs the committed check_exit_checklist.py.
# allow_failure:false makes it a BLOCKING gate before preprod.
# ──────────────────────────────────────────────────────────────────────────────
validate_exit_checklist:
  stage: UAT-exit-checklist
  image: artifactory.jfrog.sbi:443/dso-docker-base-images/ubi9/ubi9-podman-git-python-helm-jinja:1.0
  tags:
    - common_runner
  allow_failure: false
  needs:
    - job: deploy-uat
      optional: true            # wait for whichever UAT deploys the team ran
    - job: deploy-int
      optional: true
    - job: deploy-perf
      optional: true

  variables:
    ALL_TEST_CASES_EXECUTED:
      value: "No"
      options: ["Yes", "No"]
      description: "All in-scope test cases/scenarios executed, each producing the expected result."
    NO_OUTSTANDING_DEFECTS:
      value: "No"
      options: ["Yes", "No"]
      description: "No outstanding showstopper/critical/major/minor defect requiring fix or retest."
    BU_SIGNOFF_RECEIVED:
      value: "No"
      options: ["Yes", "No"]
      description: "BU sign-offs received where applicable."
    DEVIATION_APPROVALS:
      value: "No"
      options: ["Yes", "No"]
      description: "Approvals for deviations (out-of-scope / solution-doc change / open defects) are in place."

  script:
    - python3 ci/checklist/check_exit_checklist.py

  rules:
    - if: '$CI_COMMIT_BRANCH =~ /^release\//'
      when: manual
      allow_failure: false
    - when: never















