# ci/security/sca/sca.xray.yml  |  Stage: security
# JFrog Xray SCA — scans build JAR artifact against Xray watcher policy

.sca_setup:
  before_script:
    - |
      set -e
      echo "=== cert diagnostics ==="
      echo "ARTIFACTORY_CERT path : ${ARTIFACTORY_CERT:-<unset>}"
      ls -l "$ARTIFACTORY_CERT" 2>&1 || echo "cert file not readable"
      echo "cert subject/issuer:"
      openssl x509 -in "$ARTIFACTORY_CERT" -noout -subject -issuer 2>&1 || echo "(not a PEM cert or openssl missing)"
      echo "========================"

      # 1) OS trust store (for anything that reads /etc/pki/ca-trust)
      cp "$ARTIFACTORY_CERT" /etc/pki/ca-trust/source/anchors/artifactory.crt
      update-ca-trust extract

      # 2) jf's OWN cert directory — JFrog CLI does NOT rely on the OS trust store.
      #    It loads extra CAs from <JFROG_CLI_HOME_DIR>/security/certs. This is the
      #    step that actually fixes 'x509: certificate signed by unknown authority'.
      #    JFROG_CLI_HOME_DIR is set as a job variable (see .sca).
      mkdir -p "${JFROG_CLI_HOME_DIR}/security/certs"
      cp "$ARTIFACTORY_CERT" "${JFROG_CLI_HOME_DIR}/security/certs/artifactory.crt"

      jf config add \
        --url="$JF_URL" \
        --xray-url="$JF_XRAY_URL" \
        --user="$JF_USER" \
        --access-token="$JF_TOKEN" \
        --interactive=false \
        epay-server
      jf config use epay-server
      jf rt ping

.sca:
  stage: security
  # Uses the JFrog-CLI image (has the 'jf' binary). The Gradle build image does
  # NOT contain jf, which caused "jf: command not found" (exit 127). This job only
  # runs 'jf scan' on the JAR pulled via dependencies:[build] — no Gradle needed.
  image: artifactory.jfrog.sbi:443/dso-docker-base-images/ubi9/podman-jf:9.7
  tags:
    - common_runner
  variables:
    # jf's home dir — set here so BOTH before_script (cert install) and script
    # (jf scan) use the same location where we drop the SBI CA.
    JFROG_CLI_HOME_DIR: "${CI_PROJECT_DIR}/.jfrog"
    JFROG_CLI_AVOID_NEW_VERSION_WARNING: "true"
  extends: .sca_setup
  dependencies:
    - build           # the JAR to scan
    - version         # version.env dotenv → populates $VERSION (JAR filename).
                      # dependencies: RESTRICTS artifacts to the listed jobs, so
                      # without 'version' here $VERSION is empty and the path
                      # resolves to '<name>-.jar' (file not found).
  allow_failure: true
  script:
    - |
      set -eo pipefail
      ls -l build/libs/
      # Prefer the exact VERSION-named JAR; fall back to the single built JAR
      # (excluding Spring's -plain.jar) so a VERSION hiccup can't break the scan.
      JAR="build/libs/${CI_PROJECT_NAME}-${VERSION}.jar"
      if [ ! -f "$JAR" ]; then
        echo "WARN: '$JAR' not found (VERSION='${VERSION}'). Falling back to glob."
        JAR=$(ls build/libs/*.jar 2>/dev/null | grep -v -- '-plain\.jar' | head -1)
      fi
      if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
        echo "ERROR: no scannable JAR found in build/libs/." >&2
        ls -l build/libs/ >&2
        exit 1
      fi
      echo "Scanning: $JAR"
      jf scan "$JAR" --watches=EPAY-WATCHER --fail=true

sca:xray:
  extends: .sca
