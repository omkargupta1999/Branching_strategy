# ci/checklist/validate_entry_checklist.yml
# ──────────────────────────────────────────────────────────────────────────────
# UAT ENTRY checklist — manual gate on the RELEASE path.
# Running this (after filling the Yes/No answers) unlocks deploy-uat / int / perf.
#
# HOW THE UAT TEAM USES IT:
#   1. On a release/* pipeline, this job appears in stage UAT-entry-checklist as
#      a manual job (▶ play button).
#   2. Clicking ▶ opens a form pre-filled with these variables (all default "No").
#      The user changes the relevant ones to "Yes" and fills the evidence field,
#      then confirms to run the job.
#   3. The job exports them and runs check_entry_checklist.py, which FAILS the
#      job (exit 1) if any mandatory item is not "Yes" / evidence is blank.
#   4. allow_failure:false means a failed checklist BLOCKS the UAT deploys.
#
# NOTE ON INPUTS: this uses plain `variables:` (read as $VAR), NOT `inputs:` with
# ${{ }}. The ${{ job.inputs.x }} form is GitLab *component* syntax (spec:inputs),
# which only resolves when a file is pulled in via `component:` and whose form
# appears at PIPELINE-CREATION time — not when you click a manual job. The
# per-job "fill the form then run" experience you want is the manual-job VARIABLES
# form, which is what this file uses.
# ──────────────────────────────────────────────────────────────────────────────
validate_entry_checklist:
  stage: UAT-entry-checklist
  image: artifactory.jfrog.sbi:443/dso-docker-base-images/ubi9/ubi9-podman-git-python-helm-jinja:1.0
  tags:
    - common_runner
  allow_failure: false          # BLOCKING gate — must pass to unlock UAT deploys
  needs: []                     # starts as soon as the pipeline reaches this stage

  # These become the editable form fields shown when the user clicks ▶.
  # Defaults are "No" (and blank evidence) so the gate fails unless a human
  # deliberately sets them. The `description:` shows as help text in the form.
  variables:
    EPM_DEMAND_PROJECT_ID_MAPPED:
      value: "No"
      options: ["Yes", "No"]
      description: "EPM Demand id–Project id is SSOT; each Project id mapped to a unique CI/CD Epic id or child epic id."
    TEST_SCOPE_FINALIZED:
      value: "No"
      options: ["Yes", "No"]
      description: "The Test Scope has been finalized."
    SIT_COMPLETED_WITH_REPORT:
      value: "No"
      options: ["Yes", "No"]
      description: "SIT successfully completed with a QACoE-format completion report (zero open defects, 100% pass)."
    SIT_EXECUTION_EVIDENCE_ATTACHED:
      value: ""
      description: "Reference/link to SIT execution evidence (must be non-empty)."
    DEDICATED_TEST_ENV_AVAILABLE:
      value: "No"
      options: ["Yes", "No"]
      description: "A dedicated test environment with the relevant build is available for UAT."
    BUILD_HASH_SHARED:
      value: "No"
      options: ["Yes", "No"]
      description: "Hash of the deployed build has been shared with UAT."
    FUNCTIONALITY_WALKTHROUGH_DONE:
      value: "No"
      options: ["Yes", "No"]
      description: "AO/Dev team conducted a document-based functionality walkthrough for UAT."
    TEST_DATA_AVAILABLE:
      value: "No"
      options: ["Yes", "No"]
      description: "Requisite test data has been made available by IT AO / BU."
    FAR_ACCESS_PROVIDED:
      value: "No"
      options: ["Yes", "No"]
      description: "FAR access to the application from UAT team IPs is provided for all required testing."

  script:
    - python3 ci/checklist/check_entry_checklist.py

  rules:
    - if: '$CI_COMMIT_BRANCH =~ /^release\//'
      when: manual
      allow_failure: false
    - when: never
